<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:rayma_notes.ViewModels"
             x:Class="rayma_notes.Views.ViewNoteView"
             x:DataType="viewmodels:ViewNoteViewModel"
             Title="View Note">

    <ContentPage.ToolbarItems>

        <ToolbarItem Text="Delete"
                     Command="{Binding DeleteCommand}">

            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="&#57742;"
                                 FontFamily="LucideIcons"
                                 Color="White"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>

        <ToolbarItem Text="Edit"
                     Command="{Binding EditCommand}">
            
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="&#57714;"
                                 FontFamily="LucideIcons"
                                 Color="White"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *" 
          RowSpacing="10"
          Margin="10">

        <Label Text="{Binding Note.Title}" 
               FontAttributes="Bold"
               Grid.Row="0"/>

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">

            <Label Text="{Binding Note.Body}"
                   LineBreakMode="WordWrap"/>
        </ScrollView>
    </Grid>
</ContentPage>