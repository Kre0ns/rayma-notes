<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:rayma_notes.ViewModels"
             xmlns:models="clr-namespace:rayma_notes.Models"
             x:Class="rayma_notes.Views.NotesView"
             x:DataType="viewmodels:NotesViewModel"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <CollectionView ItemsSource="{Binding Notes}"
                        EmptyView="No notes yet. Start by recording one!">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border>
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="{Binding CreatedAt, StringFormat='{0:g}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>
    </Grid>
</ContentPage>