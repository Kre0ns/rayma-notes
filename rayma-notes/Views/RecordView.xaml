<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:rayma_notes.ViewModels"
             x:Class="rayma_notes.Views.RecordView"
             x:DataType="viewmodels:RecordViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Button Command="{Binding ToggleRecordingCommand}" 
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HeightRequest="{Binding Source={RelativeSource Self}, Path=Width}"
                WidthRequest="150"
                CornerRadius="75"
                Margin="10"
                ImageSource="begin_recording.png">

            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="CornerRadius" Value="30"/>
                    <Setter Property="BackgroundColor" Value="Red"/>
                    <Setter Property="ImageSource" Value="end_recording.png"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <Grid BackgroundColor="Transparent"
              IsVisible="{Binding IsBusy}">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center">

                <ActivityIndicator IsRunning="True"/>
                <Label Text="Processing your note, please wait..." />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>