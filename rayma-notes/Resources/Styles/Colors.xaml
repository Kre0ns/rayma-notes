<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="DarkPrimary">#60A5FA</Color>
    <Color x:Key="DarkSecondary">#93BBFC</Color>

    <Color x:Key="LightPrimary">#2563EB</Color>
    <Color x:Key="LightSecondary">#488bf7</Color>

    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#000000</Color>

    <Color x:Key="DarkBgDark">#000000</Color>
    <Color x:Key="DarkBg">#0c0c0d</Color>
    <Color x:Key="DarkBgLight">#18181b</Color>

    <Color x:Key="DarkText">#f2f2f3</Color>
    <Color x:Key="DarkTextMuted">#afafb6</Color>

    <Color x:Key="LightBgDark">#e4e4e7</Color>
    <Color x:Key="LightBg">#f2f2f3</Color>
    <Color x:Key="LightBgLight">#ffffff</Color>

    <Color x:Key="LightText">#0c0c0d</Color>
    <Color x:Key="LightTextMuted">#494950</Color>

    <Color x:Key="DarkBorder">#494950</Color>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorder}"/>

    <Color x:Key="LightBorder">#f2f2f3</Color>
    <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource LightBorder}"/>

</ResourceDictionary>