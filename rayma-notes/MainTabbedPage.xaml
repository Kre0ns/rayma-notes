<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:views="clr-namespace:rayma_notes.Views"
            xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
            x:Class="rayma_notes.MainTabbedPage"
            android:TabbedPage.ToolbarPlacement="Bottom">

    <views:RecordView Title="Record">
        
        <views:RecordView.IconImageSource>
            <FontImageSource Glyph="&#58714;"
                             FontFamily="LucideIcons"
                             Color="White"/>
        </views:RecordView.IconImageSource>
    </views:RecordView>

    <views:NotesView Title="Notes">

        <views:NotesView.IconImageSource>
            <FontImageSource Glyph="&#57548;"
                             FontFamily="LucideIcons"
                             Color="White"/>
        </views:NotesView.IconImageSource>
    </views:NotesView>

    <views:SettingsView Title="Settings">

        <views:SettingsView.IconImageSource>
            <FontImageSource Glyph="&#57684;"
                             FontFamily="LucideIcons"
                             Color="White"/>
        </views:SettingsView.IconImageSource>
    </views:SettingsView>

</TabbedPage>