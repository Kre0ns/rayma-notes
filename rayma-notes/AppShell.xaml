<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="rayma_notes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:rayma_notes"
    xmlns:views="clr-namespace:rayma_notes.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Rayma Notes">

    <TabBar>
        <Tab Title="Record" Icon="record_tab.png">
            <ShellContent ContentTemplate="{DataTemplate views:RecordView}" />
        </Tab>
        <Tab Title="Notes" Icon="notes_tab.png">
            <ShellContent ContentTemplate="{DataTemplate views:NotesView}" />
        </Tab>
        <Tab Title="Settings" Icon="settings_tab.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" />
        </Tab>
    </TabBar>

</Shell>
